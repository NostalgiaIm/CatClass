{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catclass.local/schema/catclass.schema.json",
  "title": "CatClass Data Contract",
  "type": "object",
  "required": ["schemaVersion", "exportedAt", "device", "spaces"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "device": {
      "$ref": "#/$defs/SyncDevice"
    },
    "spaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimetableSpace"
      }
    },
    "changeLogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChangeLog"
      },
      "default": []
    },
    "imageImportJobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImageImportJob"
      },
      "default": []
    },
    "importReviewStates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportReviewState"
      },
      "default": []
    }
  },
  "$defs": {
    "EntityMeta": {
      "type": "object",
      "required": ["id", "createdAt", "updatedAt", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "deletedAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "default": null
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TimetableSpace": {
      "allOf": [
        {
          "$ref": "#/$defs/EntityMeta"
        },
        {
          "type": "object",
          "required": ["name", "weekStartDay", "terms", "timeTemplates", "courses"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "academicYear": {
              "type": ["string", "null"],
              "default": null
            },
            "weekStartDay": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7,
              "description": "ISO weekday. 1 means Monday, 7 means Sunday."
            },
            "activeTermId": {
              "type": ["string", "null"],
              "default": null
            },
            "terms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Term"
              }
            },
            "timeTemplates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TimeTemplate"
              }
            },
            "courses": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CourseTemplate"
              }
            },
            "settings": {
              "$ref": "#/$defs/SpaceSettings"
            }
          }
        }
      ]
    },
    "Term": {
      "allOf": [
        {
          "$ref": "#/$defs/EntityMeta"
        },
        {
          "type": "object",
          "required": ["name", "startDate", "endDate", "totalWeeks", "timezone"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "startDate": {
              "type": "string",
              "format": "date"
            },
            "endDate": {
              "type": "string",
              "format": "date"
            },
            "totalWeeks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 80
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "examples": ["Asia/Shanghai"]
            }
          }
        }
      ]
    },
    "TimeTemplate": {
      "allOf": [
        {
          "$ref": "#/$defs/EntityMeta"
        },
        {
          "type": "object",
          "required": ["name", "periods"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "periods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Period"
              }
            }
          }
        }
      ]
    },
    "Period": {
      "type": "object",
      "required": ["index", "label", "startTime", "endTime"],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "startTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "endTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "CourseTemplate": {
      "allOf": [
        {
          "$ref": "#/$defs/EntityMeta"
        },
        {
          "type": "object",
          "required": ["title", "color", "scheduleRules"],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "teacher": {
              "type": ["string", "null"],
              "default": null
            },
            "location": {
              "type": ["string", "null"],
              "default": null
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "note": {
              "type": ["string", "null"],
              "default": null
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "scheduleRules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScheduleRule"
              }
            },
            "reminderRules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ReminderRule"
              },
              "default": []
            }
          }
        }
      ]
    },
    "ScheduleRule": {
      "allOf": [
        {
          "$ref": "#/$defs/EntityMeta"
        },
        {
          "type": "object",
          "required": ["termId", "dayOfWeek", "startPeriod", "periodCount", "weekMode"],
          "additionalProperties": false,
          "properties": {
            "termId": {
              "type": "string",
              "minLength": 1
            },
            "dayOfWeek": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "startPeriod": {
              "type": "integer",
              "minimum": 1
            },
            "periodCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "weekMode": {
              "type": "string",
              "enum": ["all", "odd", "even", "custom"]
            },
            "weekSet": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "default": []
            },
            "dateRange": {
              "$ref": "#/$defs/DateRange"
            },
            "exceptions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CourseException"
              },
              "default": []
            }
          }
        }
      ]
    },
    "DateRange": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        }
      },
      "default": null
    },
    "CourseException": {
      "allOf": [
        {
          "$ref": "#/$defs/EntityMeta"
        },
        {
          "type": "object",
          "required": ["date", "action"],
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "action": {
              "type": "string",
              "enum": ["cancel", "move", "replaceNote", "replaceLocation"]
            },
            "replacement": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "dayOfWeek": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "startPeriod": {
                  "type": "integer",
                  "minimum": 1
                },
                "periodCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "location": {
                  "type": ["string", "null"]
                },
                "note": {
                  "type": ["string", "null"]
                }
              },
              "default": null
            }
          }
        }
      ]
    },
    "ReminderRule": {
      "allOf": [
        {
          "$ref": "#/$defs/EntityMeta"
        },
        {
          "type": "object",
          "required": ["offsetMinutes", "channel", "enabled"],
          "additionalProperties": false,
          "properties": {
            "offsetMinutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10080
            },
            "channel": {
              "type": "string",
              "enum": ["system", "silent", "widget"]
            },
            "enabled": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "SpaceSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibleDays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "default": [1, 2, 3, 4, 5, 6, 7]
        },
        "showWeekend": {
          "type": "boolean",
          "default": true
        },
        "compactMode": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ChangeLog": {
      "type": "object",
      "required": ["id", "deviceId", "entityType", "entityId", "opType", "payload", "baseVersion", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "entityType": {
          "type": "string",
          "enum": ["space", "term", "timeTemplate", "course", "scheduleRule", "courseException", "reminderRule"]
        },
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "opType": {
          "type": "string",
          "enum": ["create", "update", "delete"]
        },
        "payload": {
          "type": "object"
        },
        "baseVersion": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SyncDevice": {
      "type": "object",
      "required": ["id", "deviceName", "platform"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "deviceName": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "enum": ["desktop-windows", "desktop-macos", "desktop-linux", "android"]
        },
        "lastSeenAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "default": null
        },
        "publicKey": {
          "type": ["string", "null"],
          "default": null
        }
      }
    },
    "VisionSource": {
      "type": "object",
      "required": ["type", "uri"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["file", "clipboard", "screenshot", "camera", "pdf"]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": ["string", "null"],
          "default": null
        },
        "width": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "height": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        }
      }
    },
    "CellBox": {
      "type": "object",
      "required": ["row", "column"],
      "additionalProperties": false,
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "rowSpan": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "columnSpan": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "text": {
          "type": ["string", "null"],
          "default": null
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "default": null
        }
      }
    },
    "RecognizedLayout": {
      "type": "object",
      "required": ["gridRows", "gridColumns", "cellBoxes", "confidence"],
      "additionalProperties": false,
      "properties": {
        "gridRows": {
          "type": "integer",
          "minimum": 1
        },
        "gridColumns": {
          "type": "integer",
          "minimum": 1
        },
        "cellBoxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CellBox"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "RecognizedTextBlock": {
      "type": "object",
      "required": ["text", "x", "y", "width", "height", "confidence"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "CourseDraft": {
      "type": "object",
      "required": ["id", "confidence", "sourceCellIds"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": ["string", "null"],
          "default": null
        },
        "teacher": {
          "type": ["string", "null"],
          "default": null
        },
        "location": {
          "type": ["string", "null"],
          "default": null
        },
        "color": {
          "type": ["string", "null"],
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": null
        },
        "note": {
          "type": ["string", "null"],
          "default": null
        },
        "dayOfWeek": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 7,
          "default": null
        },
        "startPeriod": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "periodCount": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "weekMode": {
          "type": ["string", "null"],
          "enum": ["all", "odd", "even", "custom", null],
          "default": null
        },
        "weekSet": {
          "type": ["array", "null"],
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "default": null
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "VisionIssue": {
      "type": "object",
      "required": ["code", "message", "severity"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        }
      }
    },
    "ImageImportJob": {
      "allOf": [
        {
          "$ref": "#/$defs/EntityMeta"
        },
        {
          "type": "object",
          "required": ["source", "status", "drafts"],
          "additionalProperties": false,
          "properties": {
            "source": {
              "$ref": "#/$defs/VisionSource"
            },
            "status": {
              "type": "string",
              "enum": ["pending", "processing", "reviewing", "committed", "failed"]
            },
            "previewImage": {
              "type": ["string", "null"],
              "default": null
            },
            "recognizedLayout": {
              "type": ["object", "null"],
              "allOf": [
                {
                  "$ref": "#/$defs/RecognizedLayout"
                }
              ],
              "default": null
            },
            "drafts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CourseDraft"
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/VisionIssue"
              },
              "default": []
            }
          }
        }
      ]
    },
    "ImportReviewState": {
      "type": "object",
      "required": ["jobId", "selectedDraftIds", "rejectedDraftIds"],
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "selectedDraftIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejectedDraftIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": ["string", "null"],
          "default": null
        }
      }
    }
  }
}
